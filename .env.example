# =============================================================================
# AgentOps360 Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development
APP_NAME=AgentOps360
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DOCS_ENABLED=true
SEED_DEMO_DATA=true

# --- LLM (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Mock Mode (recommended for local dev without API keys) ---
MOCK_MODE=true

# --- MongoDB ---
# Local Docker: mongodb://localhost:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentops360
# Fail startup if MongoDB is unavailable (recommended in production)
MONGODB_REQUIRED=false

# --- ChromaDB ---
# Local mode (default) — stores vectors on disk, no API key needed
CHROMA_USE_CLOUD=false
CHROMA_PERSIST_DIR=./chroma_db

# Chroma Cloud mode — set CHROMA_USE_CLOUD=true and add your API key from https://trychroma.com
# CHROMA_USE_CLOUD=true
# CHROMA_API_KEY=your-chroma-api-key-here
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=AgentOps360
# CHROMA_AUTO_CREATE_DATABASE=true
# CHROMA_FALLBACK_TO_LOCAL=true
# CHROMA_COLLECTION_NAME=agentops360_knowledge
# CHROMA_CLOUD_HOST=api.trychroma.com
# EMBEDDING_DIMENSION=1536

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Server / CORS ---
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Production checklist ---
# ENVIRONMENT=production
# MOCK_MODE=false
# OPENAI_API_KEY=sk-...
# MONGODB_REQUIRED=true
# SEED_DEMO_DATA=false
# DOCS_ENABLED=false
# CORS_ORIGINS=https://your-frontend-domain.com

# --- Optional (declared in config but NOT wired into app code yet) ---
# LANGSMITH_API_KEY=
# REDIS_URL=redis://localhost:6379
